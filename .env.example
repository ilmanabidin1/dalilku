# Kunci API Anthropic untuk fitur "tanya bebas". Tanpa kunci ini, tanya bebas
# tetap jalan dengan mode pencocokan kartu saja (tanpa ringkasan AI).
ANTHROPIC_API_KEY=
# Model AI. Ganti setelah uji akurasi bila perlu.
ANTHROPIC_MODEL=claude-opus-5-5

# Kata sandi panel admin. Wajib diisi di produksi.
ADMIN_PASSWORD_KURATOR=ganti-kurator
ADMIN_PASSWORD_PENGAWAS=ganti-pengawas
# Rahasia untuk menandatangani cookie sesi admin (string acak panjang).
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang

# Tampilkan kartu yang belum disetujui dewan pengawas (dengan label DRAF).
# Default: true saat development, false saat production.
SHOW_DRAFT_CARDS=true

# Lokasi file penyimpanan data (kartu, umpan balik, statistik).
STORE_PATH=.data/store.json

# Alamat publik situs, untuk sitemap dan tautan bagikan.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
